{
  "name": "railway-exam-prep-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready foundation for a Railway Exam Preparation Platform.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write ."
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
